Table Simulations {
  Id int [primary key]
  SimulationType int
  Status int
  CreatedAt DateTime
  StartedAt DateTime
  CompletedAt DateTime?
  VideoPath varchar
}

Table Chickens {
  Id int [primary key]
  Wins int
}

Table SimulationChickens{
  SimulationId int
  ChickenId int
  Position int
}

Table RaceSimulationConfiguration{
  SimulationId int [primary key]
}

Table RaceSimulationResults{
  SimulationId int [primary key]
  WinnerId int
}


Ref: "SimulationChickens"."SimulationId" ?>? "Simulations"."Id"

Ref: "SimulationChickens"."ChickenId" ?>? "Chickens"."Id"

Ref: "RaceSimulationResults"."WinnerId" ?>? "Chickens"."Id"

Ref: "Simulations"."Id" -? "RaceSimulationConfiguration"."SimulationId"

Ref: "Simulations"."Id" -? "RaceSimulationResults"."SimulationId"