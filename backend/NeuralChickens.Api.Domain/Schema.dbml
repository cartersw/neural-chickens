Table Simulations {
  Id int [pk, increment]
  Name nvarchar [not null]
  SimulationType int [not null, note: 'Find=0, Race=1, Sumo=2, Balance=3']
  SimulationStatus int [not null, note: 'Requested=0, Running=1, Completed=2, Failed=3, Cancelled=4']
  Contestants int [not null]
  RequestedAt datetime2 [not null]
  StartedAt datetime2
  CompletedAt datetime2
  VideoPath nvarchar [not null]
}

Table Chickens {
  Id int [pk, increment]
  Name nvarchar [not null]
  Wins int [not null]
}

Table ChickenBrains {
  Id int [pk, increment]
  SimulationType int [not null, note: 'Find=0, Race=1, Sumo=2, Balance=3']
  BrainPath nvarchar [not null]
  CreatedAt datetime2 [not null]
  ChickenId int [not null]

  indexes {
    (ChickenId, SimulationType, CreatedAt)
  }
}

Table SimulationChickens {
  SimulationId int [not null]
  ChickenId int [not null]

  indexes {
    (SimulationId, ChickenId) [pk]
    ChickenId
  }
}

Table FindSimulationConfigurations {
  SimulationId int [pk]
  Size int [not null]
}

Table FindSimulationResults {
  SimulationId int [pk]
  Wins int [not null]
}

Table RaceSimulationConfigurations {
  SimulationId int [pk]
}

Table RaceSimulationResults {
  SimulationId int [pk]
  WinnerChickenId int
}

Table BrainProcessingJobs {
  Id int [pk, increment]
  JobStatus int [not null, note: 'Requested=0, InProgress=1, Completed=2, Failed=3, Cancelled=4']
  BrainProcessClaimId uniqueidentifier
  BrainProcessLeaseExpiresAt datetime2
}

Table SimulationRenderingJobs {
  Id int [pk, increment]
  JobStatus int [not null, note: 'Requested=0, InProgress=1, Completed=2, Failed=3, Cancelled=4']
  SimulationProcessClaimId uniqueidentifier
  SimulationProcessLeaseExpiresAt datetime2
}

Ref: ChickenBrains.ChickenId > Chickens.Id [delete: cascade]

Ref: SimulationChickens.SimulationId > Simulations.Id [delete: cascade]
Ref: SimulationChickens.ChickenId > Chickens.Id [delete: restrict]

Ref: FindSimulationConfigurations.SimulationId - Simulations.Id [delete: cascade]
Ref: FindSimulationResults.SimulationId - Simulations.Id [delete: cascade]
Ref: RaceSimulationConfigurations.SimulationId - Simulations.Id [delete: cascade]
Ref: RaceSimulationResults.SimulationId - Simulations.Id [delete: cascade]
